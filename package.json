{
  "name": "dyndns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eigener DynDNS-Dienst mit Contabo-DNS und ZugangsWerk-Anmeldung",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env src/server.js",
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "openid-client": "^6.8.0"
  }
}
