[Unit]
Description=DynDNS mit Contabo und ZugangsWerk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dyndns
Group=dyndns
WorkingDirectory=/opt/dyndns
Environment=NODE_ENV=production
EnvironmentFile=/etc/dyndns.env
ExecStart=/usr/bin/node --use-env-proxy /opt/dyndns/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=dyndns
StateDirectoryMode=0700
Environment=DATA_DIR=/var/lib/dyndns
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/dyndns

[Install]
WantedBy=multi-user.target
