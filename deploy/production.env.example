NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_URL=https://dyndns.example.com
DATA_DIR=/var/lib/dyndns
SESSION_SECRET=
DEV_AUTH=false
DNS_PROVIDER=contabo
# Die bereits bei Contabo angelegte Zone; Nameserver müssen auf Contabo zeigen.
DNS_ZONE=example.com
# Ausschließlich darunter werden einzelne Hostnamen vergeben.
DYNDNS_DOMAIN=dyn.example.com
DNS_TTL=300
MAX_HOSTS_PER_USER=20
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
ACCOUNTS_URL=https://accounts.delevel.de
OIDC_ISSUER=https://accounts.delevel.de/identity/realms/zugangswerk
OIDC_CLIENT_ID=dyndns
OIDC_CLIENT_SECRET=
