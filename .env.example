# Lokal: keine echten Konten oder DNS-Änderungen. Produktion: docs/deployment.md.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data
# Erzeugen: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DNS_PROVIDER=mock
DEV_AUTH=true
DNS_ZONE=example.com
DYNDNS_DOMAIN=dyn.example.com
DNS_TTL=300
MAX_HOSTS_PER_USER=20
# Für Contabo und ZugangsWerk in der Produktion ausfüllen:
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
ACCOUNTS_URL=https://accounts.delevel.de
OIDC_ISSUER=https://accounts.delevel.de/identity/realms/zugangswerk
OIDC_CLIENT_ID=dyndns
OIDC_CLIENT_SECRET=
